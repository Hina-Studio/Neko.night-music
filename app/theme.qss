/* Now-playing page theme. Placeholders (@name@) are filled from theme.py. */

#NowPlaying {
    background: transparent;
    color: @text@;
    font-family: "Inter", "HarmonyOS Sans SC", "MiSans", "Noto Sans SC", "Microsoft YaHei UI", "Segoe UI", sans-serif;
}

#NowPlaying QLabel {
    color: @text@;
}

#NowPlaying QLabel#Dim {
    color: @text_dim@;
    font-size: 13px;
}

#NowPlaying QLabel#TrackTitle {
    font-size: 28px;
    font-weight: 500;
}

#NowPlaying QLabel#TrackMeta {
    font-size: 13px;
    color: @text_dim@;
}

#NowPlaying QLabel#BarTitle {
    font-size: 14px;
    font-weight: 500;
}

#NowPlaying QLabel#BarMeta {
    font-size: 12px;
    font-weight: 400;
    color: @text_dim@;
}

#NowPlaying QLabel#QualityCapsule {
    background: @capsule_bg@;
    border-radius: 11px;
    padding: 3px 12px;
    font-size: 12px;
    color: @text@;
}

#NowPlaying QPushButton#IconButton {
    background: transparent;
    border: none;
    padding: 5px;
    border-radius: 15px;
}

#NowPlaying QPushButton#IconButton:hover {
    background: @icon_hover_bg@;
}

#NowPlaying QPushButton#Capsule {
    background: @capsule_bg@;
    border: none;
    border-radius: 14px;
    padding: 6px 18px;
    color: @text_dim@;
    font-size: 13px;
}

#NowPlaying QPushButton#Capsule:hover {
    background: @capsule_hover@;
    color: @text@;
}

#NowPlaying QPushButton#Capsule:checked {
    background: @capsule_active@;
    color: @text@;
    font-weight: 500;
}

#NowPlaying QPushButton#PlayButton {
    background: @play_bg@;
    border: none;
    border-radius: 22px;
    padding: 0;
}

#NowPlaying QPushButton#PlayButton:hover {
    background: @play_hover@;
}

#NowPlaying QFrame#BottomBar {
    background: @bar_bg@;
    border-top: 1px solid @divider@;
    border-bottom-left-radius: @radius@px;
    border-bottom-right-radius: @radius@px;
}

#NowPlaying QSlider::groove:horizontal {
    height: 4px;
    background: rgba(255, 255, 255, 0.18);
    border-radius: 2px;
}

#NowPlaying QSlider::sub-page:horizontal {
    background: @slider_fill@;
    border-radius: 2px;
}

#NowPlaying QSlider::handle:horizontal {
    background: @text@;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

#NowPlaying QMenu {
    background: #201c1a;
    color: @text@;
    border: 1px solid @divider@;
    border-radius: 8px;
    padding: 6px;
}

#NowPlaying QMenu::item {
    padding: 7px 22px;
    border-radius: 6px;
}

#NowPlaying QMenu::item:selected {
    background: @capsule_active@;
}
